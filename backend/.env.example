# Use one backend authentication option.
# Paste the complete Firebase service-account JSON on one line when using this option.
FIREBASE_ADMIN_CREDENTIALS_JSON=replace_with_firebase_service_account_json

# Alternative: point this to a local service-account JSON file instead.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json

ATLAS_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional: connect Ask ATLAS to an OpenAI-compatible model provider.
# Leave these unset to use public-source answers without an AI key.
# ATLAS_AI_API_KEY=replace_with_model_provider_key
# ATLAS_AI_BASE_URL=https://api.openai.com/v1
# ATLAS_AI_MODEL=gpt-4o-mini
